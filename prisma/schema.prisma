generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// AUTHENTICATION
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

// ============================================================================
// ONLINE COUPONS (Existing)
// ============================================================================

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  website   String?
  /// Coupon stores are often GCC-wide, so this is a comma-separated list of
  /// country codes rather than a single value — "SA,AE". Empty means global
  /// (AliExpress, iHerb), which is valid everywhere.
  countries String   @default("SA")
  createdAt DateTime @default(now())

  coupons Coupon[]

  @@map("stores")
}

model Coupon {
  id           String   @id @default(cuid())
  title        String
  code         String
  discountText String
  /// LEGACY. Every one of the 106 rows carries '#', which is why the
  /// click-through half of the funnel never worked. Superseded by affiliateUrl;
  /// nothing reads this any more.
  url          String
  /// Where the code actually sends the shopper. A DB CHECK enforces NULL or
  /// http-prefixed, so the '#' failure cannot recur. Surfaces render NOTHING
  /// when this is null — no URL, no coupon.
  affiliateUrl String?
  /// Nullable on purpose: an owned code may be evergreen, and a forced fake
  /// expiry is the opposite of the guarantee wanted here.
  validUntil   DateTime?
  /// Only render a "حصري" badge when this is genuinely true.
  isExclusive  Boolean  @default(false)
  /// Coupon.storeId points at `stores` (Namshi/Noon); THIS points at the
  /// retailer whose page the code belongs on. Without it the retailer strip has
  /// nothing to join on.
  supermarketId String?
  description  String?  @db.Text
  storeId      String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supermarket Supermarket? @relation(fields: [supermarketId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([isActive])
  @@map("coupons")
}

// ============================================================================
// SUPERMARKET OFFERS MODULE (NEW)
// ============================================================================

// Cities for location filtering
model City {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  slug      String   @unique
  region    String? // e.g., "Riyadh Region", "Makkah Region"
  createdAt DateTime @default(now())

  supermarkets Supermarket[]
  flyers       Flyer[]

  @@map("cities")
}

// Supermarket/Retailer (Enhanced from existing)
model Supermarket {
  id        String   @id @default(cuid())
  name      String
  nameAr    String
  slug      String   @unique
  logo      String?
  website   String?
  cityId    String?
  /// ISO country code — see lib/countries.ts. Everything predating the UAE launch is SA.
  country   String   @default("SA")
  /// grocery | pharmacy | electronics. Guarded by a CHECK constraint in the DB
  /// (see app/api/admin/migrate-retailer-type).
  ///
  /// Ranking keys off the RETAILER, not the product category, because category
  /// data is re-derived nightly as products arrive and rots continuously — a
  /// Nahdi nursing wrap is filed as `canned-dry` and gummy vitamins as `snacks`,
  /// so a food-category filter cannot see them. Retailer identity does not drift.
  /// Not only a pharmacy problem: eXtra is an electronics chain listing ACER at
  /// 7,599 SAR next to groceries.
  retailerType String @default("grocery")
  isActive  Boolean  @default(true)
  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city          City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  flyers        Flyer[]
  productOffers ProductOffer[]
  coupons       Coupon[]

  @@index([slug])
  @@index([isActive])
  @@index([cityId])
  @@index([country, isActive])
  @@map("supermarkets")
}

// Flyer (PDF brochure)
model Flyer {
  id            String      @id @default(cuid())
  supermarketId String
  title         String
  titleAr       String?
  startDate     DateTime
  endDate       DateTime
  pdfUrl        String? // Cloud storage URL
  pdfPath       String? // Local file path
  coverImage    String? // First page thumbnail
  // JSON array of full-page image URLs, for retailers that publish their flyer
  // as page images rather than a PDF (e.g. LuLu UAE's in-store promotions).
  // When present the viewer renders these directly — no pdf.js, no CORS needed.
  pageImages    String?     @db.Text
  totalPages    Int         @default(0)
  status        FlyerStatus @default(DRAFT)
  viewCount     Int         @default(0)
  cityId        String?

  // Extraction metadata
  extractedAt   DateTime?
  extractionLog String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supermarket   Supermarket    @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  city          City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  productOffers ProductOffer[]

  @@index([supermarketId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([cityId])
  @@map("flyers")
}

enum FlyerStatus {
  DRAFT
  PROCESSING
  ACTIVE
  EXPIRED
  FAILED
}

// Product Categories (hierarchical)
model Category {
  id       String  @id @default(cuid())
  nameAr   String
  nameEn   String
  slug     String  @unique
  icon     String? // emoji or icon class
  parentId String?
  order    Int     @default(0)
  isActive Boolean @default(true)

  parent   Category?      @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]     @relation("CategoryToCategory")
  products ProductOffer[]

  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

// Product extracted from flyer
model ProductOffer {
  id            String  @id @default(cuid())
  flyerId       String
  supermarketId String
  categoryId    String?

  // Product info (extracted)
  nameAr          String?
  nameEn          String?
  brand           String?
  price           Float
  oldPrice        Float?
  discountPercent Int?
  sizeText        String? // "1kg", "500ml", "pack of 6"

  // Image and location in PDF
  imageUrl   String? // Cropped product image
  pageNumber Int
  bbox       String? // JSON: {x, y, width, height}

  // Scraping metadata
  sourceUrl  String? // URL where this offer was scraped from
  sourceHash String? // Deduplication hash

  // Metadata
  tags       String? // Comma-separated keywords
  confidence Float?  @default(0.5) // OCR confidence score
  isHidden   Boolean @default(false)
  viewCount  Int     @default(0)

  /// Denormalised from the supermarket. Every listing query filters by country,
  /// so keeping it on the row lets it join the existing composite indexes
  /// instead of forcing a join on 34k rows. See lib/countries.ts.
  country String @default("SA")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flyer       Flyer       @relation(fields: [flyerId], references: [id], onDelete: Cascade)
  supermarket Supermarket @relation(fields: [supermarketId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Single-column indexes
  @@index([flyerId])
  @@index([supermarketId])
  @@index([categoryId])
  @@index([price])
  // Composite indexes for common query patterns
  // Main listing query: non-hidden products sorted by date
  @@index([isHidden, createdAt])
  // Filter by supermarket + not hidden
  @@index([supermarketId, isHidden, createdAt])
  // Filter by category + not hidden
  @@index([categoryId, isHidden, createdAt])
  // Price range + not hidden
  @@index([isHidden, price])
  // Discount sort (popular query: "biggest discounts")
  @@index([isHidden, discountPercent])
  // Popular products
  @@index([isHidden, viewCount])
  // Deduplication
  @@index([sourceHash])
  // Country-scoped listing: the two sorts the offers page actually uses
  // (newest, and the discount-first default).
  @@index([country, isHidden, createdAt])
  @@index([country, isHidden, discountPercent])
  @@map("product_offers")
}

// ============================================================================
// SCRAPING LOGS
// ============================================================================

model ScrapeLog {
  id              String   @id @default(cuid())
  supermarketSlug String
  scrapedAt       DateTime @default(now())
  offersFound     Int      @default(0)
  offersCreated   Int      @default(0)
  offersSkipped   Int      @default(0)
  durationMs      Int      @default(0)
  success         Boolean  @default(true)
  errorMessage    String?  @db.Text
  logs            String?  @db.Text

  @@index([supermarketSlug, scrapedAt])
  @@map("scrape_logs")
}

// --- Shopper features (favorites + price watch) ---------------------------
// Shoppers start anonymous, identified by a random device token stored in the
// browser. `email` stays null until they log in (a later phase), so the model
// upgrades to real cross-device accounts without a rebuild.
model Shopper {
  id        String             @id @default(cuid())
  deviceId  String             @unique
  email     String?            @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  favorites Favorite[]
  watches   PriceWatch[]
  pushSubs  PushSubscription[]

  @@map("shoppers")
}

model Favorite {
  id        String   @id @default(cuid())
  shopperId String
  // ProductOffer id. Intentionally NOT a foreign key: offers rotate with
  // flyers, and a favourite should survive a row being replaced — the read
  // path resolves it and shows an "expired" state when the offer is gone.
  productId String
  createdAt DateTime @default(now())

  shopper Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  @@unique([shopperId, productId])
  @@index([shopperId])
  @@map("favorites")
}

model PriceWatch {
  id                String   @id @default(cuid())
  shopperId         String
  productId         String // the offer the watch was created from (for display)
  // Normalized product name, used to match the same item across future flyers
  // even when the offer row (and its price) is replaced.
  nameKey           String
  basePrice         Float // price when the watch started
  targetPrice       Float? // optional: only alert at or below this
  lastNotifiedPrice Float? // guards against re-alerting the same drop
  /// Market the watch was created in. Without it a Saudi shopper could be
  /// alerted about a Dirham price that merely happens to be lower.
  country           String   @default("SA")
  createdAt         DateTime @default(now())

  shopper Shopper @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  @@unique([shopperId, productId])
  @@index([shopperId])
  @@index([nameKey])
  @@map("price_watches")
}

// --- Web push --------------------------------------------------------------
/// One browser/device push endpoint. Linked to a Shopper so a price-drop alert
/// reaches the device that created the watch.
model PushSubscription {
  id        String   @id @default(cuid())
  shopperId String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  failures  Int      @default(0) // consecutive send failures; prune when high
  createdAt DateTime @default(now())

  shopper Shopper? @relation(fields: [shopperId], references: [id], onDelete: Cascade)

  @@index([shopperId])
  @@map("push_subscriptions")
}

/// Small key/value store for server-side settings that must not live in the
/// repo — currently the VAPID private key, which authorises sending push to
/// our subscribers and is therefore a genuine secret.
model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// A shopping list shared via WhatsApp.
///
/// A SNAPSHOT, not a live view. Items are denormalised into `itemsJson` rather
/// than joined to ProductOffer, for two reasons: a shared link must not break
/// when the weekly flyer rolls over and the offer rows are replaced, and opening
/// a link should cost exactly one single-row read. Because a snapshot is
/// immutable it also caches indefinitely — a link forwarded to thirty people in a
/// family group is one database read, not thirty.
///
/// `id` is a 16-char CSPRNG token generated client-side, never sequential:
/// sequential ids would let anyone enumerate other households' lists.
model SharedList {
  id        String   @id
  /// JSON array of { name, price, oldPrice, qty, storeName }.
  itemsJson String   @db.Text
  itemCount Int      @default(0)
  total     Float    @default(0)
  savings   Float    @default(0)
  /// Market the list was built in, so the reader renders the right currency.
  country   String   @default("SA")
  createdAt DateTime @default(now())
  /// Swept by the cleanup-expired cron rather than adding another schedule.
  expiresAt DateTime

  @@index([expiresAt])
  @@map("shared_lists")
}

// ============================================================================
// AD BANNERS
// ============================================================================

/// A self-managed ad banner (affiliate or sold placement), scheduled per market.
///
/// Served through lib/banners.ts (cached, tag 'banners') and rendered by
/// components/BannerSlot.tsx. Clicks route through /api/banners/click/[id] so
/// the redirect and the count are the same event; impressions arrive batched
/// from a client beacon. Both counters are lifetime totals — per-day analytics
/// can be layered on later without touching the serving path.
model Banner {
  id        String    @id @default(cuid())
  /// Internal label AND the image alt text, so write it as a shopper would read it.
  title     String
  imageUrl  String
  /// Where the click lands (affiliate deep link). A DB CHECK enforces http-prefixed,
  /// same guard as Coupon.affiliateUrl — the '#' failure must not recur here.
  targetUrl String
  /// One of lib/banners.ts BANNER_PLACEMENTS. Guarded by a DB CHECK.
  placement String
  /// ISO country code — see lib/countries.ts. A banner serves exactly one market;
  /// run the same creative twice for both.
  country   String    @default("SA")
  isActive  Boolean   @default(true)
  /// Both nullable: an open-ended banner is the common case for affiliate creatives.
  startsAt  DateTime?
  endsAt    DateTime?
  /// Highest wins the slot; ties rotate randomly per request.
  priority  Int       @default(0)
  /// Intrinsic image size when known — lets the <img> reserve space (no CLS).
  width     Int?
  height    Int?
  impressions Int     @default(0)
  clicks    Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([placement, country, isActive])
  @@map("banners")
}
