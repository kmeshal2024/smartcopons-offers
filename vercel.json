{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "//regions": "Neon lives in eu-central-1 (Frankfurt). Without this, functions default to iad1 (Washington) and every query crosses the Atlantic — ~180ms RTT, which was most of the homepage TTFB. Five source comments already claimed this was configured; it was not.",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/scrape-offers?supermarket=panda",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/scrape-offers?supermarket=danube",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/scrape-offers?supermarket=bindawood",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scrape-offers?supermarket=extra",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/scrape-offers?supermarket=alothaim",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/refresh-imported",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/expire-flyers",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup-expired",
      "schedule": "0 1 * * 0"
    },
    {
      "path": "/api/cron/price-alerts",
      "schedule": "0 6 * * *"
    }
  ]
}