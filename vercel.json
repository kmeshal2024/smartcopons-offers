{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "//regions": "Functions default to iad1 (Washington) while the Neon DB is in eu-central-1 (Frankfurt) — every query paid a transatlantic round trip, and the DB-heavy pages issue several. Pin functions to Frankfurt (fra1) so they sit next to the database; it's also far closer to Saudi users than Washington.",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/scrape-offers?supermarket=panda",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/scrape-offers?supermarket=danube",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/scrape-offers?supermarket=bindawood",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/scrape-offers?supermarket=extra",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/scrape-offers?supermarket=alothaim",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/expire-flyers",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup-expired",
      "schedule": "0 1 * * 0"
    }
  ]
}
